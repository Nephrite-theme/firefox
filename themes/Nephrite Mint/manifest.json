{
  "manifest_version": 3,
  "name": "Nephrite Mint",
  "version": "0.2",
  "description": "A calm, jade-inspired theme for Firefox. Mint flavor of the Nephrite palette.",
  "homepage_url": "https://getnephrite.dev",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nephrite-mint@getnephrite.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#d7eadf",
      "frame_inactive": "#c7ded1",
      "tab_selected": "#edfbf3",
      "tab_text": "#192e23",
      "tab_background_text": "#3f5247",
      "tab_line": "#048149",
      "tab_loading": "#048149",
      "toolbar": "#edfbf3",
      "toolbar_text": "#192e23",
      "toolbar_top_separator": "#c7ded1",
      "toolbar_bottom_separator": "#c7ded1",
      "icons": "#3f5247",
      "icons_attention": "#048149",
      "button_background_hover": "#cbe1d4",
      "button_background_active": "#bdd5c7",
      "toolbar_field": "#daeee2",
      "toolbar_field_text": "#192e23",
      "toolbar_field_border": "#cbe1d4",
      "toolbar_field_focus": "#daeee2",
      "toolbar_field_text_focus": "#192e23",
      "toolbar_field_border_focus": "#048149",
      "toolbar_field_highlight": "#048149",
      "toolbar_field_highlight_text": "#edfbf3",
      "popup": "#d7eadf",
      "popup_text": "#192e23",
      "popup_border": "#daeee2",
      "popup_highlight": "#cbe1d4",
      "popup_highlight_text": "#192e23",
      "sidebar": "#d7eadf",
      "sidebar_text": "#192e23",
      "sidebar_border": "#c7ded1",
      "sidebar_highlight": "#cbe1d4",
      "sidebar_highlight_text": "#192e23",
      "ntp_background": "#edfbf3",
      "ntp_text": "#192e23",
      "ntp_card_background": "#daeee2"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
